@model List<swas.DAL.Models.PermissionMaster>

@{
    ViewData["Title"] =
    "Permission Master";
}

<div class="card">

    <div class="card-header
    d-flex justify-content-between">

        <h5>
            Permission Master
        </h5>

        <button class="btn btn-primary"
                onclick="OpenAddEdit(0)">
            Add Permission
        </button>

    </div>

    <div class="card-body">

        <table id="tblPermission"
               class="table table-striped table-bordered">

            <thead>
                <tr>
                    <th>
                        Permission Key
                    </th>

                    <th>
                        Display Name
                    </th>

                    <th>
                        Module
                    </th>

                    <th>
                        Type
                    </th>

                    <th>
                        Order
                    </th>

                    <th>
                        Status
                    </th>

                    <th>
                        Action
                    </th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item
                in Model)
                {
                    <tr>

                        <td>
                            @item.PermissionKey
                        </td>

                        <td>
                            @item.DisplayName
                        </td>

                        <td>
                            @item.ModuleName
                        </td>

                        <td>
                            @item.PermissionType
                        </td>

                        <td>
                            @item.DisplayOrder
                        </td>

                        <td>
                            @(item.IsActive
                                ? "Active"
                                : "Inactive")
                        </td>

                        <td>

                            <button class="btn btn-warning btn-sm"
                                    onclick="OpenAddEdit(@item.Id)">
                                Edit
                            </button>

                            <button class="btn btn-danger btn-sm"
                                    onclick="DeletePermission(@item.Id)">
                                Delete
                            </button>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
</div>

<div class="modal fade"
     id="permissionModal">

    <div class="modal-dialog
    modal-lg">

        <div class="modal-content">

            <div id="permissionModalBody">
            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="~/DeveloperJs/PermissionMaster.js">
    </script>
}