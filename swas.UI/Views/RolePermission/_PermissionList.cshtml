@model swas.BAL.DTO.RolePermissionDTO

<input type="hidden"
       id="RoleId"
       value="@Model.RoleId" />

<div class="card">

    <div class="card-header">

        <h5>
            Role :
            @Model.RoleName
        </h5>

    </div>

    <div class="card-body">

        <div class="row">

            @foreach (var item
            in Model.Permissions)
            {
                <div class="col-md-4 mb-3">

                    <div class="form-check">

                        <input class="form-check-input permission-checkbox"
                               type="checkbox"
                               value="@item.PermissionKey"
                        @(item.IsSelected
                            ? "checked"
                            : "") />

                        <label class="form-check-label">

                            @item.DisplayName

                        </label>

                    </div>

                </div>
            }

        </div>

        <button class="btn btn-success"
                onclick="SavePermissions()">

            Save Permissions

        </button>

    </div>

</div>