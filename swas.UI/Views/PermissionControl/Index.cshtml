@{
    ViewData["Title"] = "Permission Control";
}

@Html.AntiForgeryToken()

<div class="container-fluid mt-3">

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">
                Centralized Permission Control
            </h5>
        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4">
                    <label class="form-label fw-bold">
                        Permission For
                    </label>

                    <select id="PermissionFor"
                            class="form-control select2">
                        <option value="">
                            -- Select --
                        </option>
                        <option value="Role">
                            Role
                        </option>
                        <option value="User">
                            User
                        </option>
                        <option value="Unit">
                            Unit
                        </option>
                    </select>
                </div>

                <div class="col-md-5">
                    <label class="form-label fw-bold">
                        Select Role / User / Unit
                    </label>

                    <select id="TargetId"
                            class="form-control select2">
                        <option value="">
                            -- Select --
                        </option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button type="button"
                            id="btnLoadPermissions"
                            class="btn btn-primary w-100">
                        Load Permissions
                    </button>
                </div>

            </div>

            <hr />

            <div id="permissionContainer">
                <div class="alert alert-info mb-0">
                    Please select permission type and target.
                </div>
            </div>

        </div>
    </div>

</div>
<script src="~/developerjs/permissionmaster.js"></script>
