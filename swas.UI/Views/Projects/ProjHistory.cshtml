@using Microsoft.AspNetCore.Identity
@using swas.BAL.Helpers
@using Microsoft.AspNetCore.Authorization
@inject IHttpContextAccessor HttpContextAccessor
@using swas.BAL.DTO
@model List<ProjHistory>
@{
    ViewBag.Title = "Project History List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int snoa = 0;
    int? DataProjId = ViewBag.DataProjId as int?;
}
@{
    int projIdFromViewBag = Convert.ToInt32(ViewBag.Projid);
    Login Logins = SessionHelper.GetObjectFromJson<Login>(HttpContextAccessor?.HttpContext?.Session, "User");
    var project = Model.FirstOrDefault()?.ProjectDetl?[1];
    var isSpecialForm = project?.ProposalId == 7 || project?.ProposalId == 8;
}


<link href="~/css/projhistory.css" rel="stylesheet" />
<link href="~/css/ProjectwiseReport.css" rel="stylesheet" />

<div class="row d-flex justify-content-center mt-5">
    <span id="spnstageid" class="d-none">@ViewBag.stageid</span>
    <span id="spntabType" class="d-none">@ViewBag.Type</span>
    <span id="IsProcess" class="d-none">@ViewBag.Isprocess</span>

    <span id="IsCommentPsmiId" class="d-none">@ViewBag.IsCommentPsmiId</span>
    <!--Proj Details-->
    <div class="card-body">
        <div class="card radius-10 w-100">
            <div class="card-body">
                <div class="table-responsive">
