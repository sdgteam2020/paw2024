@using swas.DAL.Models
@{

    ViewData["Title"] = "Proj Comments";
    int sno = 0;
}
<link href="~/assets/css/tooltip.css" rel="stylesheet" />
<link href="~/jquery/autocomplete.css" rel="stylesheet" />
<link href="~/css/projcomments.css" rel="stylesheet" />
<link href="~/css/_projectpendingstatus.css" rel="stylesheet" />

<!----Table for Stakeholder Status Change----->
<div class="card-body mt-5">
    <div class="card radius-10 w-100">
        <div class="card-body">
            <div class="mb-3">
                <div class="comment-toolbar">
                <!-- Button group -->
                <div class="col-md-24 d-flex align-items-center" role="group">
                    <button type="button" class="btn btn-danger bodradi btn-sm mr-2 cmtbtn btn-3d" id="btnPending">Pending</button>
                    <button type="button" class="btn btn-success bodradi btn-sm mr-2 cmtbtn btn-3d" id="btnAccepted">Accepted</button>
                    <button type="button" class="btn btn-warning bodradi btn-sm mr-2 cmtbtn btn-3d text-white" id="btnObsn">Obsn</button>
                    <button type="button" class="btn btn-danger bodradi btn-sm mr-2 cmtbtn btn-3d" id="btnRejected">Rejected</button>
                    <button type="button" class="btn btn-info bodradi btn-sm mr-2 text-white cmtbtn btn-3d" id="btnInfo">Info</button>
                    <button type="button" class="btn btn-info bodradi btn-sm mr-2 text-white cmtbtn btn-3d" id="btnNA"> Not Applicable</button>
                      </div>

                    <div class="comment-filter-group flex-end">
                        <div class="d-flex justify-content-between align-items-center mb-2" title="Mark the selected projects as Not Applicable">
                            <div class="d-flex align-items-center gap-2">
                                <button id="btnMarkNA"
                                        type="button"
                                        class="btn-mark-na"
                                        disabled
                                        >
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="16"
                                         height="16"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         aria-hidden="true">
                                        <path d="M12 3h6a1 1 0 0 1 1 1v6a1 1 0 0 1-.3.7l-8 8a1 1 0 0 1-1.4 0l-6-6a1 1 0 0 1 0-1.4l8-8a1 1 0 0 1 .7-.3z"></path>
                                        <circle cx="16" cy="8" r="1.5" fill="currentColor" stroke="none"></circle>
                                    </svg>
                                    <span>Mark as Not Applicable</span>
                                    <span id="selCount" class="na-count"></span>
                                </button>
                            </div>
                        </div>
                        <!-- Project Type -->
                        <div class="project-type-filter">

                            <label for="ddlProjectType"
                                   class="project-filter-label">
                                Project Type
                            </label>

                            <select id="ddlProjectType"
                                    class="form-control form-control-sm project-type-select"
                                    asp-items="ViewBag.ProjectTypeOptions">
                            </select>

                        </div>


                        <!-- Search -->
                        <div class="project-search-wrapper">

                            <div class="input-group input-group-sm">

                                <div class="input-group-prepend">
                                    <span class="input-group-text project-search-icon">

                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="16"
                                             height="16"
                                             fill="currentColor"
                                             class="bi bi-search"
                                             viewBox="0 0 16 16">

                                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />

                                        </svg>

                                    </span>
                                </div>

                                <input type="text"
                                       id="CommentProject"
                                       class="form-control"
                                       placeholder="Search project..." />

                            </div>

                        </div>

                    </div>
                    
                </div>
                <div class="mt-2">
                  

                </div>
                <!-- Section heading -->
                <div class="header-container text-center">
                    <h4 class="text-light ">
                        StakeHolder Comments
                    </h4>
                </div>
                
            </div>

            <table id="Comment" class="table table-striped table-bordered">
                <!-- Table header -->
                <thead>
                    <tr>

                        <th class="noExport d-none"></th>
                         <th  id="notapplicableHeader" class="noExport" data-orderable="false">
                            <input type="checkbox" id="selectAll" titl  e="Select All to Mark as Not Applicable For StakeHolder Comments">
                            <span class="ms-1">Not Applicable</span>
                        </th>
                        <th class="s-no-column ">Ser No</th>
                        <th>Proj Id</th>
                        <th>Project Name</th>
                        <th>Stakeholder</th>
                        <th>Recd on</th>
                        <th>Status</th>
                        <th class="noExport">Action</th>

                    </tr>
                </thead>

                <tbody id="DetailBody">
                </tbody>

            </table>


        </div>
    </div>
</div>



<script src="~/developerjs/mtable.js"></script>
@* <script src="~/developerjs/projectstkholdercomments.js"></script> *@
<script src="~/developerjs/NewProject.js"></script>
<script src="~/developerjs/CommanDatatable.js"></script>
<script src="~/developerjs/Tooltip.js"></script>
 
<script src="~/jquery/autocomplete.js"></script>
