														<div class="invalid-feedback">AI/ML Project Required</div>
													</div>
												</div>
												<div class="col-md-4">
													<div class="input-container">
														@Html.DropDownListFor(model => model.IsWhitelisted,
																										(IEnumerable<SelectListItem>)ViewBag.WhitelistOptions,
																										new { @class = "form-select requiredField", required = "required" })
														<label for="@Html.IdFor(model => model.IsWhitelisted)">Already Whitelisted<font class="paw-red-font"><b>*</b></font></label>

														<div class="invalid-feedback">Whitelist Status Required</div>
													</div>
												</div>



												<div class="col-md-4">
