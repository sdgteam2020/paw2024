														<label class="btn btn-outline-primary" for="autoDate">On</label>
														<input type="radio" class="btn-check" name="mcalender_dates" id="Manualdate" value="0" @(selectedvalue == 0 ? "checked" : "")>
														<label class="btn btn-outline-primary" for="Manualdate">Off</label>
													</div>
												</div>

												<div class="col-md-4">
													<div class="flex-grow-1 mb-2 d-flex flex-column">
