                             data-bs-target="#collapseBasic"
                             aria-expanded="true"
                             aria-controls="collapseBasic">
                            <div class="h4 mb-0">New Project</div>
                        </div>
                    <input type="button" class="btn btn-danger m-2 d-none" id="tempBasicDetails" value="Dummy Data" />


                    <div class="collapse show" id="collapseBasic">
                     
