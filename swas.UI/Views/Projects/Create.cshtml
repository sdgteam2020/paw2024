@using Newtonsoft.Json;
@using System.Web
@using swas.BAL.Helpers
@using swas.BAL.Repository
@using swas.DAL
@using swas.DAL.Models
@using swas.BAL.Interfaces
@using swas.BAL.DTO
@using System.Text.Encodings.Web

@model tbl_Projects
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewBag.Title = "Projects List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    Login Logins = SessionHelper.GetObjectFromJson<Login>(HttpContextAccessor.HttpContext.Session, "User");
    int calendarMode = Context.Session.GetInt32("CalendarMode") ?? 0;
    var ProjEncryId = ViewBag.ProjectEncyId;
    var selectedvalue = Model?.Date_type ?? 0;

	
	bool isSubbmit = ViewBag.issubmit == true;


	bool isdisabled = Model?.IsSubmited == true && Model?.IsProcess == false;
    var today = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
}




<link href="~/assets/css/tooltip.css" rel="stylesheet" />

<link href="~/css/createproject.css" rel="stylesheet" />

<body>

