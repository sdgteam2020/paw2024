																															htmlAttributes = new
																															{
																																@class = "form-control requiredField char-limit mergeprojnamewithrevet",
																																@data_maxlength = "1200",
																																required = "required",

																																@placeholder = "Max 200 Word"
																															}
																														})

															<label for="@Html.IdFor(model => model.ProjName)">Name Of Project<span class="inputcount"></span><font class="paw-red-font"><b>*</b></font></label>
