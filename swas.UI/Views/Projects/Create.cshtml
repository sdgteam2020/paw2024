															<label for="@Html.IdFor(model => model.DecisionSoughtWayForward)"><span class="font-13">Decision Sought / Way Forward<span class="inputcount"></span></span><font class="paw-red-font"><b>*</b></font></label>
															<span class="charErrorMsg d-none paw-red-font">Cannot exceed 50 Words!</span>
															<div class="invalid-feedback">Decision Sought / Way Forward Required</div>
														</div>
													</div>
													<div class="col-md-4">
														<div class="input-container">
															@Html.EditorFor(model => model.MobileNo,
																new { htmlAttributes = new { @class = "form-control requiredField char-limit MobileNo", type = "number", @data_maxlength = "10", required = "required", @placeholder = "Max Char 10 " } })
															<label for="@Html.IdFor(model => model.MobileNo)">MobileNo (Tele No)<span class="inputcount"></span><font class="paw-red-font"><b>*</b></font></label>
															<span class="charErrorMsg d-none paw-red-font">Cannot exceed 10 characters!</span>
															<div class="invalid-feedback">Mobile Number Required</div>
														</div>
													</div>
													<div class="col-md-4">
														<div class="input-container">
															@Html.EditorFor(model => model.AsconNo,
																new { htmlAttributes = new { @class = "form-control requiredField char-limit AsconNo", type = "number", @data_maxlength = "5", required = "required", @placeholder = "Max Char 5 " } })
															<label for="@Html.IdFor(model => model.AsconNo)">Ascon No<span class="inputcount"></span><font class="paw-red-font"><b>*</b></font></label>
															<span class="charErrorMsg d-none paw-red-font">Cannot exceed 5 characters!</span>
															<div class="invalid-feedback">Army Number Required</div>
														</div>
													</div>
												</div>

												<!-- Row 3 -->
												
												<div class="row g-3 mb-3">
													<div class="col-md-6">
														<div class="input-container">
															@Html.TextAreaFor(model => model.Proposal_for_title,
																new { @class = "form-control char-limit", @data_maxlength = "600", @placeholder = "Max 100 Words" })
															<label for="@Html.IdFor(model => model.Proposal_for_title)">Proposal For Title<span class="inputcount"></span><font class="paw-red-font"><b>*</b></font></label>
															<span class="charErrorMsg d-none paw-red-font">Cannot exceed 100 Words!</span>
															<div class="invalid-feedback">Breif Justification Required</div>
														</div>
													</div>
													<div class="col-md-6">
														<div class="input-container">
															@Html.TextAreaFor(model => model.InitialRemark,
																new { @class = "form-control char-limit", @data_maxlength = "600",@placeholder = "Max 100 Words" })
															<label for="@Html.IdFor(model => model.InitialRemark)">Remarks<span class="inputcount"></span></label>
															<span class="charErrorMsg d-none paw-red-font">Cannot exceed 100 Words!</span>
															@* <div class="invalid-feedback">Breif Justification Required</div> *@
														</div>
													</div>
												</div>

											</div>
										</div>

										<!-- Submit Button -->
										<div class="text-center">
											<input type="button"
												   id="submitUpload"
												   class="next action-button"
												   value="Save & Upload PDF" />
										</div>
									</div>
								</fieldset>


								<fieldset id="2">
									<div class="form-card">
										<div class="row">
											<div class="col-7">
												<h2 class="fs-title">Upload</h2>
											</div>
											<div class="col-5">
												<div class="steps">Step 3 of 4</div>
											</div>
										</div>
										@Html.Partial("_newprojfwdupload")
									</div>

									<input type="button" id="draftUpload" class="draftUpload next header-container text-center text-white enabled-button" value="Save Draft" />
									<input type="button" id="finalupload" class="next header-container text-center text-white @(ProjEncryId != null ? "enabled-button" : "disabled-button")"
										   value="Submit to DDGIT" @(ProjEncryId == null ? "disabled" : "") />
								</fieldset>
                                
                                <fieldset id="3">
                                    <div class="form-card">
                                        <div class="row">
                                            <div class="col-7">
                                                <h2 class="fs-title"></h2>
                                            </div>
                                           
                                        </div>

                                        <div class="row justify-content-center">
                                            <center>
                                                <br><br>
                                                <h2 class="text-deep-blue text-center">
                                                    <strong>
                                                        <span id="projectId"></span><br><br>
                                                        Project Successfully submitted to DDGIT <br><br>
                                                        (Tele No: 39865, 20862706)
                                                    </strong>
                                                </h2>
                                                <br><br />
                                                <a href="/Projects/Create">
                                                    <input type="button" class="next header-container text-center text-white" value="Add More Projects" />
                                                </a><br>
                                                <a href="/Home/Index">
                                                    <input type="button" class="next header-container text-center text-white" value="Dashboard" />
                                                </a>
                                            </center>
                                        </div>
                                    </div>
                                </fieldset>

                            }
                        </div>
                    </div>

                

                
                </div>
               
			</div>
        </div>
    </div>

    <div class="card radius-10 w-100 mb-3">
        <div class="card-body">
            <div class="header-container text-center mb-3">
                <h4 class="text-white fw-bold mt-2 fs-6 fs-md-5">
                    Initiated Projects <br class="d-sm-none" />
                    (Drafts & Submissions to DDGIT)
                </h4>
            </div>

            <div class="table-responsive">
                <table id="SoftwareType1" class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Project Name</th>
                            <th>Hosted On</th>
                            <th>App Type</th>
                            <th>Type Of SW</th>
                            <th>Devp Mode</th>
                            <th>Initiated Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var project in ViewBag.Projects)
                        {
                            <tr>
                                <td>
                                    @if (project.IsSubmited == true && project.IsProcess == true)
                                    {
                                        <img src="~/assets/images/icons/accept.png" width="18" height="18" alt="Readed">
                                    }
                                    else
                                    {
                                        <img src="~/assets/images/icons/pending.png" width="18" height="18" alt="Readed">
                                    }
                                </td>

                                <td class="RefLetter-container">
                                    @{
                                        var name = project.ProjName ?? "No Name";
                                        var shortName = project.ProjName.Length > 25 ? project.ProjName.Substring(0, 25) + "...." : name;
                                    }

                                    <div class="tooltip-container" data-tooltip="@project.ProjName">
                                        <span class="short-text noExport">@shortName</span>
                                        <span class="tooltip tooltip-text">@project.ProjName</span>
                                    </div>
                                </td>

                                <td>@project.HostType</td>
                                <td>@project.Apptype</td>
                                <td>@project.TypeofSW</td>
                                <td>@project.BeingDevpInhouse</td>
                                <td>@project.InitiatedDate</td>
                                <td>
                                    @if ( project.IsProcess == false)
                                    {
                                        <center>
                                            <a href="@Url.Action("Create", "Projects", new { id = project.EncyID })">
                                                <div data-project-id="@project.EncyID" id="ProjDetailId-@project.ProjId">
                                                    <img src="/assets/images/icons/edit.png" alt="Icon" class="edit-icon">
                                                </div>
                                            </a>
                                        </center>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>

</body>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script src="~/DeveloperJs/CreateProjects.js"></script>
<script src="~/developerjs/atthistory.js?v1"></script>
<script src="~/developerjs/mtable.js?v1"></script>
@* <script src="~/DeveloperJs/Comman.js?v1"></script> *@
<script src="~/developerjs/Tooltip.js"></script>

