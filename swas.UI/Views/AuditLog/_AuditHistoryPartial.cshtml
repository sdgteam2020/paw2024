@using swas.BAL.DTO
@model List<AuditLogViewModel>

<style>
    .audit-card {
        border-left: 4px solid #0d6efd;
        border-radius: 10px;
        background: #fff;
        margin-bottom: 15px;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
    }

    .audit-header {
        padding: 12px 15px;
        background: #f8f9fa;
        border-bottom: 1px solid #eee;
    }

    .audit-project {
        font-size: 16px;
        font-weight: 600;
    }

    .audit-meta {
        color: #6c757d;
        font-size: 13px;
    }

    .audit-body {
        padding: 15px;
    }

    .change-row {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        flex-wrap: wrap;
    }

    .change-label {
        width: 100px;
        font-weight: 600;
        color: #495057;
    }

    .change-values {
        flex: 1;
    }

    .old-badge {
        background: #fde2e2;
        color: #b42318;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 13px;
    }

    .new-badge {
        background: #d1fadf;
        color: #027a48;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 13px;
    }

    .arrow {
        margin: 0 10px;
        font-weight: bold;
        color: #6c757d;
    }
</style>
@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning text-center">
        <i class="fa fa-info-circle"></i>
        Audit Log Not Found
    </div>
}
else
{
    <div class="text-center mb-4">
        <h6 class="fw-bold text-primary">
         Project Name:   @Model.First().ProjectName
        </h6>
        <hr />
    </div>
    @foreach (var item in Model)
    {
        <div class="audit-card mb-3">

            <div class="audit-header">
                

                <span class="float-end">
                    @item.ChangedBy |
                    @item.ChangedAt.ToString("dd-MMM-yyyy HH:mm")
                </span>
            </div>

            <div class="audit-body">

                @foreach (var change in item.Changes)
                {
                    <div class="change-row">

                        <div class="change-label">
                            @change.FieldName
                        </div>

                        <div class="change-old">
                            🔴 @change.OldValue
                        </div>

                        <div class="change-arrow">
                            →
                        </div>

                        <div class="change-new">
                            🟢 @change.NewValue
                        </div>

                    </div>
                }

            </div>

        </div>
    }
}