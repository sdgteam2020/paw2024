    @using swas.BAL.DTO
    @model List<ProjLogView>


    @{
        ViewData["Title"] = "Search Details";
        Layout = "~/Views/Shared/_Layout.cshtml";
        int sno = 1;
    }




<link href="~/css/getprojlogview.css" rel="stylesheet" />
  

<div class="container-fluid mt-4">

    <div class="page-header-box">
        <h4>Project Log Search Details</h4>
        <p>Search and view project movement, action, user and remarks details.</p>
    </div>

    <div id="searchContainer" class="search-card">
        <form asp-action="GetProjLogview" method="post" id="searchFormProjName">

            @Html.AntiForgeryToken()

            <div class="row align-items-end justify-content-center g-3">

                <div class="col-lg-3 col-md-4 col-sm-12">
                    <label for="fromDate">From Date</label>
                    <input name="fromDate"
                           id="fromDate"
                           type="date"
                           class="datePicker form-control"
                           value="@TempData["fromDate"]" />
                </div>

                <div class="col-lg-3 col-md-4 col-sm-12">
                    <label for="toDate">To Date</label>
                    <input name="toDate"
                           id="toDate"
                           type="date"
                           class="datePicker form-control"
                           value="@TempData["toDate"]" />
                </div>

                <div class="col-lg-2 col-md-3 col-sm-12">
                    <button type="button"
                            class="btn btn-primary btn-sm btn-search-custom"
                            id="SearchData">
                        <i class="fas fa-search me-1"></i> Search
                    </button>
                </div>

            </div>

        </form>
    </div>

    <div id="tableProjContainer">
        <div class="table-card">

            <div class="table-card-header">
                <h5>
                    <i class="fas fa-list-alt text-primary me-2"></i>
                    Project Log Details
                </h5>

                <span class="record-count">
                    Total Records: @(Model != null ? Model.Count : 0)
                </span>
            </div>

            <div class="card-body tblprojcontainer">
                <div class="table-responsive">

                    <table id="SoftwareType" class="table table-striped table-bordered table-hover align-middle">
                        <thead>
                            <tr>
                                <th>S/No</th>
                                <th>Proj Name</th>
                                <th>Sponsor</th>
                                <th>Stage</th>
                                <th>Sub Stage</th>
                                <th>Action</th>
                                <th>User ID</th>
                                <th>TimeStamp</th>
                                <th>Fwd By</th>
                                <th>Fwd To</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>

                        <tbody id="searchtableProj">
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">@sno</td>
                                        <td>@item.ProjName</td>
                                        <td>@item.UnitName</td>
                                        <td>@item.Stages</td>
                                        <td>@item.Status</td>
                                        <td>@item.Actions</td>
                                        <td>@item.ActionByUser</td>
                                        <td>@item.TimeStamp</td>
                                        <td>@item.FwdBy</td>
                                        <td>@item.FwdTo</td>
                                        <td class="remarks-cell">@item.AddRemarks</td>
                                    </tr>

                                    sno++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="11">
                                        <div class="empty-table-box">
                                            No project log records found.
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>

        </div>
    </div>

</div>

<script src="~/developerjs/getprojlogview.js"></script>